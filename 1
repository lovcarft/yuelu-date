<!-- 这是一个基于高级社交UI风格的布局片段 -->
<div class="relative min-h-screen bg-gradient-to-br from-indigo-50 via-white to-emerald-50">
    <!-- 背景装饰 -->
    <div class="absolute top-0 left-0 w-full h-64 bg-emerald-500 rounded-b-[50px] -z-10"></div>
    
    <div class="pt-12 px-6">
        <h1 class="text-3xl font-extrabold text-white mb-2">麓下实验室</h1>
        <p class="text-emerald-50 opacity-90">寻找跨校的灵魂共鸣</p>
        
        <!-- 核心卡片 -->
        <div class="mt-8 bg-white/80 backdrop-blur-lg rounded-[32px] p-8 shadow-2xl border border-white">
            <h2 class="text-xl font-bold text-gray-800 mb-6">开启你的角色卡</h2>
            
            <!-- 更加直观的学校选择器 -->
            <div class="space-y-4">
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest">选择你的基地</p>
                <div class="grid grid-cols-1 gap-3">
                    <button class="w-full py-4 rounded-2xl border-2 border-gray-100 hover:border-emerald-500 hover:bg-emerald-50 transition-all text-left px-6 flex justify-between items-center group">
                        <span class="font-bold text-gray-700">湖南大学 (HNU)</span>
                        <div class="w-2 h-2 bg-gray-200 rounded-full group-hover:bg-emerald-500"></div>
                    </button>
                    <!-- 中南、师大以此类推... -->
                </div>
            </div>

            <!-- 既然不看脸，这里可以加一个“性格关键词”气泡选择区 -->
            <div class="mt-8">
               <!-- ...标签选择区... -->
            </div>
        </div>
    </div>
</div>
